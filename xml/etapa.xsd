<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.uniovi.es"
           xmlns="http://www.uniovi.es"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:simpleType name="tipoEtapaType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="llana"/>
      <xs:enumeration value="montaña"/>
      <xs:enumeration value="contrarreloj individual"/>
      <xs:enumeration value="contrarreloj por equipos"/>
      <xs:enumeration value="media montaña"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="categoriaPuertoType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="1a"/>
      <xs:enumeration value="2a"/>
      <xs:enumeration value="3a"/>
      <xs:enumeration value="especial"/>
      <xs:enumeration value="bonificado"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="tipoSprintType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="intermedio"/>
      <xs:enumeration value="bonificado"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="valorNoDisponibleType">
    <xs:restriction base="xs:string">
      <xs:pattern value="NO DISPONIBLE.*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="numeroEtapaType">
    <xs:restriction base="xs:positiveInteger">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="21"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="coordenadaGradoType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-180"/>
      <xs:maxInclusive value="180"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="altitudType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-200"/>
      <xs:maxInclusive value="9000"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="distanciaKmType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="5000"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="velocidadMediaType">
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:decimal">
          <xs:minInclusive value="0"/>
          <xs:maxInclusive value="100"/>
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType>
        <xs:restriction base="valorNoDisponibleType"/>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <xs:simpleType name="duracionType">
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:duration"/>
      </xs:simpleType>
      <xs:simpleType>
        <xs:restriction base="valorNoDisponibleType"/>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>

  <xs:complexType name="coordLongitudType">
    <xs:simpleContent>
      <xs:extension base="coordenadaGradoType">
        <xs:attribute name="unidad" type="xs:string" fixed="deg" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="coordLatitudType">
    <xs:simpleContent>
      <xs:extension base="coordenadaGradoType">
        <xs:attribute name="unidad" type="xs:string" fixed="deg" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="coordAltitudType">
    <xs:simpleContent>
      <xs:extension base="altitudType">
        <xs:attribute name="unidad" type="xs:string" fixed="m" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="coordenadasType">
    <xs:sequence>
      <xs:element name="coord_longitud" type="coordLongitudType"/>
      <xs:element name="coord_latitud" type="coordLatitudType"/>
      <xs:element name="coord_altitud" type="coordAltitudType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="lugarType">
    <xs:sequence>
      <xs:element name="nombre_lugar" type="xs:string"/>
      <xs:element name="coordenadas" type="coordenadasType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="distanciaKmConUnidadType">
    <xs:simpleContent>
      <xs:extension base="distanciaKmType">
        <xs:attribute name="unidad" type="xs:string" fixed="km" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="fotoType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="ruta" use="required">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\.(jpg|jpeg|png|gif|bmp|JPG|JPEG|PNG|GIF|BMP)"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="videoType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="ruta" use="required">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\.(mp4|avi|mkv|webm|MP4|AVI|MKV|WEBM)"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="sonidoType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="ruta" use="required">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value=".*\.(mp3|wav|ogg|MP3|WAV|OGG)"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="clasificadoType">
    <xs:sequence>
      <xs:element name="nombre_corredor" type="xs:string"/>
      <xs:element name="equipo" type="xs:string"/>
      <xs:element name="tiempo" type="duracionType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="clasificadoConDiferenciaType">
    <xs:sequence>
      <xs:element name="nombre_corredor" type="xs:string"/>
      <xs:element name="equipo" type="xs:string"/>
      <xs:element name="tiempo" type="duracionType"/>
      <xs:element name="diferencia" type="duracionType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="clasificadoGeneralType">
    <xs:sequence>
      <xs:element name="nombre_corredor" type="xs:string"/>
      <xs:element name="equipo" type="xs:string"/>
      <xs:element name="diferencia" type="duracionType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="equipoClasificadoType">
    <xs:sequence>
      <xs:element name="nombre_equipo" type="xs:string"/>
      <xs:element name="tiempo" type="duracionType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="equipoClasificadoConDiferenciaType">
    <xs:sequence>
      <xs:element name="nombre_equipo" type="xs:string"/>
      <xs:element name="tiempo" type="duracionType"/>
      <xs:element name="diferencia" type="duracionType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="etapa">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="nombre" type="xs:string"/>
        <xs:element name="numero" type="numeroEtapaType"/>
        <xs:element name="longitud_km">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="distanciaKmType">
                <xs:attribute name="unidad" type="xs:string" fixed="km" use="required"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
        <xs:element name="fecha" type="xs:date"/>
        <xs:element name="tiempo_ganador" type="duracionType"/>
        <xs:element name="velocidad_media">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="velocidadMediaType">
                <xs:attribute name="unidad" type="xs:string" fixed="km/h" use="required"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>
        <xs:element name="desnivel_m">
          <xs:complexType>
            <xs:simpleContent>
              <xs:extension base="altitudType">
                <xs:attribute name="unidad" type="xs:string" fixed="m" use="required"/>
              </xs:extension>
            </xs:simpleContent>
          </xs:complexType>
        </xs:element>

        <xs:element name="salida">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="lugar" type="lugarType"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="llegada">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="lugar" type="lugarType"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="referencias">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="referencia" type="xs:string" minOccurs="3" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="galeria_fotos">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="foto" type="fotoType" minOccurs="1" maxOccurs="5"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="galeria_videos">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="video" type="videoType" minOccurs="1" maxOccurs="3"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="galeria_sonidos">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="sonido" type="sonidoType" minOccurs="1" maxOccurs="3"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="hitos">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="puertos" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="puerto" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="nombre_puerto" type="xs:string"/>
                          <xs:element name="coordenadas" type="coordenadasType"/>
                          <xs:element name="distancia_km" type="distanciaKmConUnidadType"/>
                        </xs:sequence>
                        <xs:attribute name="categoria" type="categoriaPuertoType" use="required"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>

              <xs:element name="sprints" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="sprint" minOccurs="0" maxOccurs="unbounded">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="nombre_sprint" type="xs:string"/>
                          <xs:element name="coordenadas" type="coordenadasType"/>
                          <xs:element name="distancia_km" type="distanciaKmConUnidadType"/>
                        </xs:sequence>
                        <xs:attribute name="tipo" type="tipoSprintType" use="required"/>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="puntos_anonimos" minOccurs="0" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="punto" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="coordenadas" type="coordenadasType"/>
                    <xs:element name="distancia_km" type="distanciaKmConUnidadType"/>
                  </xs:sequence>
                  <xs:attribute name="nombre" type="xs:string" use="optional"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="clasificacion_etapa">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="primero" type="clasificadoType"/>
              <xs:element name="segundo" type="clasificadoConDiferenciaType"/>
              <xs:element name="tercero" type="clasificadoConDiferenciaType"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="clasificacion_general">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="primero" type="clasificadoType"/>
              <xs:element name="segundo_general" type="clasificadoGeneralType"/>
              <xs:element name="tercero_general" type="clasificadoGeneralType"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="clasificacion_equipos">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="primero_equipo" type="equipoClasificadoType"/>
              <xs:element name="segundo_equipo" type="equipoClasificadoConDiferenciaType"/>
              <xs:element name="tercero_equipo" type="equipoClasificadoConDiferenciaType"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="tipo" type="tipoEtapaType" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
